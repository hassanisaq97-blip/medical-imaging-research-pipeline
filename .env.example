# Copy to .env and fill in for your machine. Never commit the real .env file.

# Root directory of the (legitimately obtained) Multimodal-HC dataset,
# e.g. /Volumes/data/Multimodal-HC/train — see docs/data_access.md.
DATASET_ROOT=/path/to/Multimodal-HC/train

# Where curated manifests, checkpoints, and job outputs are written.
MEDIMG_OUTPUT_ROOT=./outputs

# Torch device override: auto | cpu | mps | cuda. "auto" picks
# cuda -> mps -> cpu automatically (see medimg_pipeline.utils.device).
MEDIMG_DEVICE=auto

# Job queue infrastructure (docker-compose defaults shown).
REDIS_URL=redis://localhost:6379/0
MEDIMG_API_HOST=0.0.0.0
MEDIMG_API_PORT=8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
MEDIMG_LOG_LEVEL=INFO

# Secret salt for deterministic DICOM pseudonymization (medimg_pipeline
# anonymize/ingest). Generate your own, e.g. `openssl rand -hex 16`, and
# keep it secret -- anyone with this salt and an original identifier can
# reconstruct the pseudonym mapping. Never commit the real value.
MEDIMG_ANON_SALT=
